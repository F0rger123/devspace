rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for Projects
    function isValidProject(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.description is string && data.description.size() <= 2000
        && data.status in ['Active', 'Paused', 'Completed', 'Planning']
        && data.createdAt is number;
    }

    // Validation for Issues
    function isValidIssue(data) {
      return data.id is string && data.id.size() <= 128
        && data.projectId is string && data.projectId.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.type in ['Task', 'Bug', 'Feature']
        && data.status in ['Todo', 'In Progress', 'Done']
        && data.priority in ['Low', 'Medium', 'High', 'Critical']
        && data.createdAt is number;
    }

    // Validation for Users
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 200
        && data.username is string && data.username.size() <= 100
        && (!('displayName' in data) || data.displayName is string)
        && (!('avatarColor' in data) || data.avatarColor is string)
        && (!('title' in data) || data.title is string)
        && (!('bio' in data) || data.bio is string)
        && (!('updatedAt' in data) || data.updatedAt is number)
        && data.createdAt is number;
    }

    // Validation for Invitations
    function isValidInvitation(data) {
      return data.id is string && data.id.size() <= 128
        && data.projectId is string && data.projectId.size() <= 128
        && data.projectName is string && data.projectName.size() <= 200
        && data.senderId is string && data.senderId.size() <= 128
        && data.senderEmail is string && data.senderEmail.size() <= 200
        && data.senderName is string && data.senderName.size() <= 100
        && data.receiverEmail is string && data.receiverEmail.size() <= 200
        && data.status in ['pending', 'accepted', 'declined']
        && data.role in ['admin', 'editor', 'viewer']
        && (!('inviteLink' in data) || (data.inviteLink is string && data.inviteLink.size() <= 1000))
        && data.createdAt is number;
    }

    // Rules for projects
    match /projects/{projectId} {
      allow read: if isSignedIn() && (
        existing() == null || 
        !('ownerId' in existing()) || 
        existing().ownerId == request.auth.uid || 
        (request.auth.token.email != null && existing().collaborators is list && request.auth.token.email in existing().collaborators)
      );
      
      allow create: if isSignedIn() 
        && isValidId(projectId) 
        && isValidProject(incoming())
        && incoming().id == projectId;
        
      allow update: if isSignedIn() 
        && isValidId(projectId)
        && isValidProject(incoming())
        && incoming().id == projectId
        && (
          existing() == null || 
          !('ownerId' in existing()) || 
          existing().ownerId == request.auth.uid || 
          (request.auth.token.email != null && existing().collaborators is list && request.auth.token.email in existing().collaborators)
        );
        
      allow delete: if isSignedIn() 
        && isValidId(projectId)
        && (
          existing() == null || 
          !('ownerId' in existing()) || 
          existing().ownerId == request.auth.uid
        );
    }

    // Rules for issues
    match /issues/{issueId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
        && isValidId(issueId) 
        && isValidIssue(incoming())
        && incoming().id == issueId
        && exists(/databases/$(database)/documents/projects/$(incoming().projectId));
      allow update: if isSignedIn() 
        && isValidId(issueId)
        && isValidIssue(incoming())
        && incoming().id == issueId
        && incoming().projectId == existing().projectId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isValidId(issueId);
    }

    // Rules for users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidUser(incoming());
      allow delete: if false;
    }

    // Rules for invitations
    match /invitations/{invitationId} {
      allow read: if isSignedIn() && (
        existing() == null || 
        existing().senderId == request.auth.uid || 
        (request.auth.token.email != null && existing().receiverEmail == request.auth.token.email)
      );
      allow create: if isSignedIn() 
        && isValidId(invitationId)
        && isValidInvitation(incoming())
        && incoming().id == invitationId
        && incoming().senderId == request.auth.uid;
      allow update: if isSignedIn() 
        && isValidId(invitationId)
        && isValidInvitation(incoming())
        && incoming().id == invitationId
        && (
          existing().senderId == request.auth.uid || 
          (request.auth.token.email != null && existing().receiverEmail == request.auth.token.email)
        );
      allow delete: if isSignedIn() 
        && isValidId(invitationId)
        && (
          existing().senderId == request.auth.uid || 
          (request.auth.token.email != null && existing().receiverEmail == request.auth.token.email)
        );
    }
  }
}
