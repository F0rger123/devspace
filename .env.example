# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# EMAIL CONFIGURATION (Optional Nodemailer SMTP dispatcher for Aether Reports)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_RECIPIENT=

# SPOTIFY INTEGRATION (Optional OAuth client)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ELEVEN LABS (Optional TTS voice synthesizer)
ELEVEN_LABS_API_KEY=

# GITHUB TOKEN (Optional GitHub API integration)
GITHUB_TOKEN=
